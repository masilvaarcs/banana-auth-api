## .NET / C# gitignore

# Build results
bin/
obj/
out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Sensitive configuration — NEVER commit
appsettings.Development.json
appsettings.Production.json
*.pfx
*.p12
secrets.json

# Entity Framework
*.db
*.sqlite

# OS
.DS_Store
Thumbs.db
desktop.ini

# Language Server / editor cache
*.lscache

# GitHub Copilot / AI agent artifacts
.github/
AGENTS.md

# Test results
TestResults/
coverage/
*.coverage
*.coveragexml

# Publish
publish/
